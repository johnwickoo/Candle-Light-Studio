{   
  "compilerOptions": {
    "target": "es2020",            
    "module": "commonjs",           /* Specify module code generation: 'commonjs'. */
    "moduleResolution": "node",     /* Resolve modules using Node.js module resolution. */
    "esModuleInterop": true,        /* Enables module interop for commonjs. */
    "outDir": "./dist",             /* Redirect output structure to this directory. */
    "rootDir": "./",                /* Specify the root directory of source files. */

    /* Strictness */
    "strict": true,                 /* Enable all strict type-checking options. */
    "skipLibCheck": true,           /* Skip type checking of declaration files. */

    /* Source Maps (Helpful for debugging) */
    "sourceMap": true               /* Generates corresponding '.map' file. */
  },
  "include": [
    "**/*.js",  // Finds all JavaScript files (index.js, etc.)
    "**/*.ts"   // **<--- ADD THIS LINE to find TypeScript files (index.ts, etc.)**
  ]
}