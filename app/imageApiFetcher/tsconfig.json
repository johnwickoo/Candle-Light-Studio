{   
  "compilerOptions": {
    "target": "es2020",            
    "module": "commonjs",           
    "moduleResolution": "node",     
    "esModuleInterop": true,        
    "outDir": "./dist",
    "rootDir": "./src",
    "allowJs": true,           // <--- IMPORTANT: Allows tsc to process .js files
    "strict": true,                 
    "skipLibCheck": true,           
    "sourceMap": true               
  },
  "include": [
    "**/*.js",   
    "**/*.ts"
    // Remove .tsx if your function code definitely has no JSX/React
  ]
}