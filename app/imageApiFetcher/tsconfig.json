{   
  "compilerOptions": {
    "target": "es2020",            
    "module": "NodeNext",           
    "moduleResolution": "NodeNext",     
    "esModuleInterop": true,        
    "outDir": "./dist",             // Compiled output goes here
    "rootDir": "./",                // <--- FIX 1: The source files are in the root (./)
    "allowJs": true,                // Important for compiling .js files
    "strict": true,                 
    "skipLibCheck": true,           
    "sourceMap": true               
  },
  "include": [
    "**/*.js",                      // Will find index.js in the root
    "**/*.ts"                       // For future TS files
  ],
  "exclude": [
    "dist"                          // <--- FIX 2: Exclude the output folder from compilation input
  ]
}